{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "joblink-bleu",  "name": "JobLink bleu",  "color": "#3b6fd4" },
        { "slug": "joblink-fonce", "name": "JobLink foncé", "color": "#2b2f38" },
        { "slug": "joblink-clair", "name": "JobLink clair", "color": "#eaf0fc" }
      ]
    }
  },
  "styles": {
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|joblink-bleu" }
      },
      "button": {
        "color": {
          "background": "var:preset|color|joblink-bleu",
          "text": "#ffffff"
        },
        "border": { "radius": "999px" }
      },
      "heading": {
        "color": { "text": "var:preset|color|joblink-fonce" }
      }
    }
  }
}